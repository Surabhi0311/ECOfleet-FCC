{
  "name": "ecofleet-fullstack",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "node --watch server/index.js",
    "client:dev": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build",
    "test:api": "node --test server/tests/*.test.js",
    "package:tomcat": "sh ./scripts-tomcat.sh",
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
